# ============================================================
# Election Verification — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env — it is in .gitignore
# ============================================================

# --- Google Cloud API Key ---
# Used for: Cloud Vision OCR, Google Drive API, Gemini API
# Get from: https://console.cloud.google.com/apis/credentials
# IMPORTANT: Restrict this key to specific APIs + IP addresses!
GOOGLE_CLOUD_API_KEY=

# --- Gemini API Key ---
# Used for: Gemini Flash OCR (primary model)
# Get from: https://aistudio.google.com/app/apikey
# Or use the same Google Cloud API key with Generative Language API enabled
GEMINI_API_KEY=

# --- Anthropic API Key (Optional) ---
# Used for: Claude as third OCR model for cross-validation
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================================
# Security Checklist (see SECURITY.md for details):
#   [ ] Budget alert set at $50/month in Google Cloud Console
#   [ ] API key restricted to specific APIs only
#   [ ] API key restricted to your IP address(es)
#   [ ] Gemini API daily quota set to 5,000 requests
#   [ ] Cloud Function uses IAM auth (not --allow-unauthenticated)
# ============================================================
